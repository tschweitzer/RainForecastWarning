# Copy to terraform.tfvars and fill in. Do not commit the filled-in copy.
project_id = "rainchecker-195519"
region     = "europe-west3"

# Cloud Run serves https on its own generated hostname with a managed certificate, so this needs
# no domain and no certificate work. It is two-pass by nature - the service has to exist before
# its URL is known, and it cannot reference its own uri without a dependency cycle:
#
#   1. leave this commented out and apply
#   2. terraform output api_url
#   3. paste it here and apply again
#
# Do not invent a value for pass one. Every link in every message is built from this, and it is
# also the overlays bucket's only allowed CORS origin, so a made-up hostname is a service whose
# links go nowhere and whose map shows nothing - with no error anywhere, because it is a
# perfectly well-formed URL. https is not cosmetic either: the session cookie only gets its
# Secure flag when this starts with https, and browsers refuse geolocation outside a secure
# context, so the locate control on both maps cannot work until it does.
# public_base_url = "https://rainalert-000000000000.europe-west3.run.app"

# By digest, not by tag: a tag is mutable, and a digest is what makes a rollback mean something.
#
# It also means this line has to change on EVERY deploy. `make image-push` prints the whole line
# ready to paste. An apply that still names the previous digest redeploys the previous code and
# reports "Apply complete!" - there is no error, and the fix you just built simply is not there.
image = "europe-west3-docker.pkg.dev/rainchecker-195519/rainalert/rainalert@sha256:..."

alert_email = "you@example.org"

# --- Email: leave this out entirely for a push-only deployment -------------------------------
# With smtp_host empty (the default) the signup page offers push only, the API refuses the email
# channel rather than accepting an address it cannot write to, and the SMTP password secret is
# not mounted. Nothing else changes, and turning email on later is this variable plus the
# secret version.
#
# The sending domain needs SPF, DKIM and DMARC before any of this is worth doing - without them
# the warnings land in spam, which is the same as not sending them.
# smtp_host     = "smtp-relay.brevo.com"
# smtp_port     = 587
# smtp_username = "your-smtp-login"
# mail_from     = "RainAlert <noreply@example.org>"

# --- Basemap ---------------------------------------------------------------------------------
# Nothing to set: the default is basemap.de Web Raster (BKG), which needs no key and no account.
# CC BY 4.0, no quota, and no non-commercial clause - so it stays valid if this service ever
# carries ads. Germany only, which is the right shape because the DE1200 radar composite stops
# at roughly the same border (DESIGN.md D-43).
#
# Confirm the endpoint once before you rely on it - a WMTS path is easy to get subtly wrong and
# a wrong one renders blank tiles rather than an error:
#   make verify-basemap
#
# To use a different provider instead. NOTE the key here is public - it lands in the rendered
# HTML and in every visitor's network tab - so restrict it by HTTP referer in the provider's
# console, or somebody else will spend your quota:
# map_tile_url         = "https://tiles.example.com/{z}/{x}/{y}.png?key=YOUR_KEY"
# map_tile_attribution = "&copy; Example Maps"
#
# Watch the placeholder order when you switch. basemap.de is WMTS and wants {z}/{y}/{x}; most
# OSM-derived providers want {z}/{x}/{y}. Swapping them renders a scrambled map, not an error.
#
# Watch the licence too. Several providers' free tiers are non-commercial only - Stadia, Jawg and
# MapTiler at the time of writing - which stops being allowed the day this page carries
# advertising. basemap.de and Esri (2M tiles/month free, then metered) have no such clause, and
# CARTO drops from 5M to 1M tiles/month when the use is commercial. docs/LOCAL.md
# §"Choosing a basemap" has the comparison.
#
# For no basemap at all - the radar over a graticule with cities marked, which is a supported
# state and not a broken map - set both to empty:
# map_tile_url         = ""
# map_tile_attribution = ""
#
# What local development used to use (docs/LOCAL.md), kept here as a warning rather than an
# option: OpenStreetMap's own tile servers are volunteer-run and their usage policy excludes
# applications. One browser looking at a map is light; a deployed service is an application, and
# they will block it - rightly. Do not uncomment this:
# map_tile_url         = "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# map_tile_attribution = "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# --- Push ------------------------------------------------------------------------------------
# The public server sees every topic name and every message body. Fine for a first test, worth
# self-hosting before anyone but you relies on it.
# ntfy_server = "https://ntfy.sh"
